{
  "name": "realestate-microservice",
  "version": "0.1.0",
  "private": true,
  "description": "Hệ thống thuê nhà microservices (NestJS monorepo)",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm -r --if-present build",
    "keys:generate": "node scripts/generate-jwt-keys.mjs",
    "contracts:check": "node contracts/scripts/check-events.mjs && node contracts/scripts/check-openapi.mjs",
    "infra:up": "docker compose --env-file .env -f infra/compose/docker-compose.yml --profile dev up -d",
    "infra:demo": "docker compose --env-file .env -f infra/compose/docker-compose.yml --profile demo up -d",
    "infra:check": "powershell -NoProfile -ExecutionPolicy Bypass -File infra/scripts/check-infra.ps1",
    "infra:down": "docker compose --env-file .env -f infra/compose/docker-compose.yml --profile demo --profile apps down",
    "infra:logs": "docker compose --env-file .env -f infra/compose/docker-compose.yml --profile demo logs -f --tail=100"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "yaml": "^2.9.1"
  }
}
