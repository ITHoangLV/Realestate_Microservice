# =============================================================================
# .env.example của service. Sao chép thành .env (KHÔNG commit .env):
#   Copy-Item .env.example .env      (`pnpm dev` tự làm việc này nếu chưa có .env)
# Giá trị mẫu chỉ dùng cho dev local, khớp với giá trị mẫu của .env gốc repo.
# Thiếu biến bắt buộc (SERVICE_NAME) hoặc sai định dạng thì service dừng ngay khi khởi động.
# =============================================================================

# ---------- Tối thiểu (luôn cần) ----------
# Môi trường chạy: development | test | production
NODE_ENV=development
# Cổng HTTP của identity-service (khớp IDENTITY_PORT trong .env gốc)
PORT=3001
# Tên service, xuất hiện trong log, /health và tài liệu Swagger (BẮT BUỘC, không có mặc định)
SERVICE_NAME=identity
# Mức log: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# true: log màu dễ đọc bằng pino-pretty (chỉ dev); false: JSON một dòng ra stdout
LOG_PRETTY=false

# ---------- HTTP client gọi service khác ----------
# Timeout mỗi lần gọi (ms). Lưu ý: .env gốc ghi 5000, template mặc định 3000
HTTP_TIMEOUT_MS=3000
# Số lần thử lại tối đa (chỉ GET/lệnh idempotent)
HTTP_MAX_RETRIES=2

# ---------- Swagger / Idempotency ----------
# Bật Swagger ở /api/docs (nên tắt ở production)
SWAGGER_ENABLED=true
# Thời gian lưu kết quả Idempotency-Key trong Redis (giây): 24 giờ
IDEMPOTENCY_TTL_SECONDS=86400

# =============================================================================
# Cấu hình RIÊNG của identity-service
# =============================================================================

# ---------- PostgreSQL (BẮT BUỘC) ----------
# Laptop dùng cổng 5433; trong Docker dùng host postgres cổng 5432.
DATABASE_URL=postgres://identity_user:change_me_identity@localhost:5433/identity_db

# ---------- RabbitMQ: identity CHỈ PUBLISH event (identity.registered), không consume ----------
# vhost "/" phải viết %2F. KHÔNG đặt RABBITMQ_QUEUE (bỏ trống = không consume).
RABBITMQ_URL=amqp://rabbit_admin:change_me_rabbitmq@localhost:5672/%2F
# RABBITMQ_EXCHANGE=domain.events
# OUTBOX_POLL_INTERVAL_MS=1000
# OUTBOX_BATCH_SIZE=50

# ---------- JWT RS256 (BẮT BUỘC) ----------
# Tạo khóa một lần ở gốc repo: pnpm keys:generate
# Đường dẫn tính từ thư mục service (services/identity).
# Khóa riêng: CHỈ identity dùng để KÝ token. Khóa công khai: để chính identity kiểm tra /me
# (các service khác chỉ cần JWT_PUBLIC_KEY_PATH).
JWT_PRIVATE_KEY_PATH=../../secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=../../secrets/jwt-public.pem
# Issuer ghi vào token và được kiểm tra khi verify
JWT_ISSUER=realestate-identity
# Access token sống 15 phút, refresh token sống 7 ngày (giây)
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# ---------- Redis (BẮT BUỘC): lưu refresh token, TTL tự xóa token hết hạn ----------
REDIS_URL=redis://:change_me_redis@localhost:6379
# Tiền tố key Redis của refresh token (đổi khi nhiều môi trường dùng chung một Redis)
# REFRESH_TOKEN_REDIS_PREFIX=identity:

# ---------- Chỉ dùng khi test: false = event ghi vào outbox nhưng KHÔNG gửi lên RabbitMQ ----------
# OUTBOX_RELAY_ENABLED=true

# S3: identity không dùng.
