# =============================================================================
# .env.example - mau bien moi truong. Copy thanh .env (khong commit .env).
#   PowerShell: Copy-Item .env.example .env
# Gia tri mau chi dung cho dev/demo local. KHONG dung bi mat that o day.
# Quy uoc: khong dung dau cach/dau nhay/ky tu dac biet trong gia tri de
# docker compose va NestJS doc giong nhau.
# =============================================================================

# ---------- Chung ----------
# Moi truong chay: development | production | test
NODE_ENV=development
# Muc log: debug | info | warn | error
LOG_LEVEL=debug

# ---------- Cong cac service (host) ----------
# api-gateway: diem vao duy nhat cho client
GATEWAY_PORT=8080
# identity-service: dang ky/dang nhap, phat hanh JWT
IDENTITY_PORT=3001
# listing-service: tin dang phong, tim kiem
LISTING_PORT=3002
# rental-service: dat lich xem, giu cho, hop dong thue
RENTAL_PORT=3003
# payment-service: vi trung gian, dat coc, rut tien
PAYMENT_PORT=3004
# notification-service: thong bao
NOTIFICATION_PORT=3005
# assistant-service: chatbot goi y phong
ASSISTANT_PORT=3006
# maintenance-service (tuy chon)
MAINTENANCE_PORT=3007
# mobility-service (tuy chon)
MOBILITY_PORT=3008

# ---------- PostgreSQL (dung chung 1 instance, 4 DB rieng) ----------
# Host/port: service chay tren may host dung localhost; trong compose dung ten "postgres"
POSTGRES_HOST=localhost
# Cong PostgreSQL publish ra may host
POSTGRES_PORT=5432
# Tai khoan superuser, chi dung de chay script khoi tao DB
POSTGRES_SUPERUSER=postgres
# Mat khau superuser (mau)
POSTGRES_SUPERUSER_PASSWORD=change_me_pg_superuser
# DB mac dinh cua superuser
POSTGRES_DEFAULT_DB=postgres

# identity_db
IDENTITY_DB_NAME=identity_db
# User rieng chi vao duoc identity_db
IDENTITY_DB_USER=identity_user
# Mat khau user identity (mau)
IDENTITY_DB_PASSWORD=change_me_identity

# listing_db (bat extension postgis)
LISTING_DB_NAME=listing_db
# User rieng chi vao duoc listing_db
LISTING_DB_USER=listing_user
# Mat khau user listing (mau)
LISTING_DB_PASSWORD=change_me_listing

# rental_db
RENTAL_DB_NAME=rental_db
# User rieng chi vao duoc rental_db
RENTAL_DB_USER=rental_user
# Mat khau user rental (mau)
RENTAL_DB_PASSWORD=change_me_rental

# payment_db
PAYMENT_DB_NAME=payment_db
# User rieng chi vao duoc payment_db
PAYMENT_DB_USER=payment_user
# Mat khau user payment (mau)
PAYMENT_DB_PASSWORD=change_me_payment

# ---------- Redis ----------
# Host Redis (trong compose: redis)
REDIS_HOST=localhost
# Cong Redis publish ra may host
REDIS_PORT=6379
# Mat khau Redis (mau)
REDIS_PASSWORD=change_me_redis

# ---------- RabbitMQ ----------
# Host RabbitMQ (trong compose: rabbitmq)
RABBITMQ_HOST=localhost
# Cong AMQP
RABBITMQ_PORT=5672
# Cong giao dien Management UI
RABBITMQ_MANAGEMENT_PORT=15672
# Tai khoan RabbitMQ (mau)
RABBITMQ_USER=rabbit_admin
# Mat khau RabbitMQ (mau)
RABBITMQ_PASSWORD=change_me_rabbitmq
# Virtual host
RABBITMQ_VHOST=/
# Exchange su kien domain (topic, durable)
RABBITMQ_EXCHANGE=domain.events

# ---------- Object storage S3 (Silo, thay MinIO - xem docs/adr/ADR-007) ----------
# --- Phia container (image giu ten bien MINIO_* de tuong thich) ---
# Cong S3 API publish ra may host (chi bind 127.0.0.1)
S3_API_PORT=9000
# Cong web console publish ra may host (chi bind 127.0.0.1)
S3_CONSOLE_PORT=9001
# Tai khoan root cua container (mau)
MINIO_ROOT_USER=minio_admin
# Mat khau root cua container (mau, toi thieu 8 ky tu)
MINIO_ROOT_PASSWORD=change_me_minio
# --- Phia ung dung (AWS SDK) ---
# Dia chi S3 API (trong compose: http://s3:9000)
S3_ENDPOINT=http://localhost:9000
# Region gia lap cho AWS SDK
S3_REGION=us-east-1
# Access key; o dev dung cung gia tri MINIO_ROOT_USER
S3_ACCESS_KEY=minio_admin
# Secret key; o dev dung cung gia tri MINIO_ROOT_PASSWORD
S3_SECRET_KEY=change_me_minio
# Bat buoc true voi S3 tu host (path-style: endpoint/bucket)
S3_FORCE_PATH_STYLE=true
# Bucket anh tin dang (listing-service tu tao khi khoi dong)
S3_BUCKET_LISTING_IMAGES=listing-images
# Bucket anh QR ngan hang (payment-service)
S3_BUCKET_BANK_QR=bank-qr
# Bucket chung tu thanh toan (payment-service)
S3_BUCKET_PAYMENT_PROOFS=payment-proofs
# Bucket giay to nguoi thue (rental-service)
S3_BUCKET_TENANT_DOCS=tenant-docs
# ---------- MongoDB ----------
# Host MongoDB (trong compose: mongo)
MONGO_HOST=localhost
# Cong MongoDB
MONGO_PORT=27017
# Tai khoan root MongoDB (mau)
MONGO_ROOT_USER=mongo_admin
# Mat khau root MongoDB (mau)
MONGO_ROOT_PASSWORD=change_me_mongo
# Ten DB Mongo mac dinh (gia dinh dung cho notification/assistant, can chot o GD sau)
MONGO_DB_NAME=app_mongo

# ---------- Elasticsearch / Kibana (chi profile demo) ----------
# Cong Kibana publish ra may host
KIBANA_PORT=5601

# ---------- Dia chi service noi bo (goi HTTP giua service) ----------
# Chay service tren host dung localhost; khi dong goi vao compose doi thanh ten service
INTERNAL_IDENTITY_URL=http://localhost:3001
# URL noi bo listing-service
INTERNAL_LISTING_URL=http://localhost:3002
# URL noi bo rental-service
INTERNAL_RENTAL_URL=http://localhost:3003
# URL noi bo payment-service
INTERNAL_PAYMENT_URL=http://localhost:3004
# URL noi bo notification-service
INTERNAL_NOTIFICATION_URL=http://localhost:3005
# URL noi bo assistant-service
INTERNAL_ASSISTANT_URL=http://localhost:3006
# URL noi bo maintenance-service (tuy chon)
INTERNAL_MAINTENANCE_URL=http://localhost:3007
# URL noi bo mobility-service (tuy chon)
INTERNAL_MOBILITY_URL=http://localhost:3008

# Timeout goi HTTP noi bo (ms)
HTTP_TIMEOUT_MS=5000
# So lan thu lai khi goi HTTP noi bo that bai
HTTP_MAX_RETRIES=2

# ---------- Quy tac nghiep vu theo thoi gian (giay) ----------
# Thoi gian giu cho (reservation) truoc khi tu huy: 24 gio
RESERVATION_TTL_SECONDS=86400
# Han chu nha/ben nhan nhan tien (payment claim): 3 ngay
PAYMENT_CLAIM_TTL_SECONDS=259200
# SLA admin xu ly yeu cau (vi du rut tien): 24 gio
ADMIN_SLA_SECONDS=86400

# ---------- JWT ----------
# Duong dan khoa cong khai (RS256) de cac service xac thuc token
JWT_PUBLIC_KEY_PATH=./secrets/jwt-public.pem
# Duong dan khoa rieng, chi identity-service dung de ky token
JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem
# Thoi han access token (giay): 15 phut
JWT_ACCESS_TTL_SECONDS=900
# Thoi han refresh token (giay): 7 ngay
JWT_REFRESH_TTL_SECONDS=604800
# Issuer ghi trong token
JWT_ISSUER=realestate-identity
