{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realestate.local/contracts/events/rental.completed.v1.schema.json",
  "title": "rental.completed",
  "x-producer": "rental",
  "allOf": [{ "$ref": "envelope.v1.schema.json" }],
  "properties": {
    "eventType": { "const": "rental.completed" },
    "version": { "const": 1 },
    "producer": { "const": "rental" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reservationId", "listingId", "tenantId", "landlordId"],
      "properties": {
        "reservationId": {
          "type": "string",
          "format": "uuid",
          "description": "Reservation (rental sở hữu)"
        },
        "listingId": {
          "type": "string",
          "format": "uuid",
          "description": "Tin đăng (listing sở hữu)"
        },
        "tenantId": { "type": "string", "format": "uuid", "description": "Người thuê (identity)" },
        "landlordId": { "type": "string", "format": "uuid", "description": "Chủ nhà (identity)" }
      }
    }
  }
}
