{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realestate.local/contracts/events/rental.viewing-requested.v1.schema.json",
  "title": "rental.viewing-requested",
  "description": "ViewingRequested: người thuê đăng ký xem (không chọn giờ; giờ xem chốt qua chat)",
  "x-producer": "rental",
  "allOf": [
    {
      "$ref": "envelope.v1.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "rental.viewing-requested"
    },
    "version": {
      "const": 1
    },
    "producer": {
      "const": "rental"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "viewingId",
        "listingId",
        "tenantId",
        "ownerId"
      ],
      "properties": {
        "viewingId": {
          "type": "string",
          "format": "uuid",
          "description": "Lịch xem (rental sở hữu)"
        },
        "listingId": {
          "type": "string",
          "format": "uuid",
          "description": "Tin đăng (listing sở hữu)"
        },
        "tenantId": {
          "type": "string",
          "format": "uuid",
          "description": "Người thuê (identity)"
        },
        "ownerId": {
          "type": "string",
          "format": "uuid",
          "description": "Chủ trọ (identity)"
        }
      }
    }
  }
}
