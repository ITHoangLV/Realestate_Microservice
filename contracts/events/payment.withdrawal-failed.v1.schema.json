{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realestate.local/contracts/events/payment.withdrawal-failed.v1.schema.json",
  "title": "payment.withdrawal-failed",
  "description": "WithdrawalFailed: chuyển khoản thất bại, ví không đổi",
  "x-producer": "payment",
  "allOf": [
    {
      "$ref": "envelope.v1.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "payment.withdrawal-failed"
    },
    "version": {
      "const": 1
    },
    "producer": {
      "const": "payment"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["withdrawalId", "depositId", "ownerId", "amountVnd", "reason"],
      "properties": {
        "withdrawalId": {
          "type": "string",
          "format": "uuid",
          "description": "Lệnh rút (payment sở hữu)"
        },
        "depositId": {
          "type": "string",
          "format": "uuid",
          "description": "Đơn đặt cọc (rental sở hữu)"
        },
        "ownerId": {
          "type": "string",
          "format": "uuid",
          "description": "Chủ trọ (identity)"
        },
        "amountVnd": {
          "type": "integer",
          "minimum": 1,
          "description": "Số tiền của lệnh (VND)"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Lý do thất bại"
        }
      }
    }
  }
}
