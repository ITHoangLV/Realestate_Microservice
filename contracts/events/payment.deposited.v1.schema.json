{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realestate.local/contracts/events/payment.deposited.v1.schema.json",
  "title": "payment.deposited",
  "description": "DepositPaid: webhook payOS hợp lệ, tiền vào ví trung gian (BR-08)",
  "x-producer": "payment",
  "allOf": [
    {
      "$ref": "envelope.v1.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "payment.deposited"
    },
    "version": {
      "const": 1
    },
    "producer": {
      "const": "payment"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "depositId",
        "orderId",
        "tenantId",
        "ownerId",
        "amountVnd",
        "payosReference",
        "paidAt"
      ],
      "properties": {
        "depositId": {
          "type": "string",
          "format": "uuid",
          "description": "Đơn đặt cọc (rental sở hữu)"
        },
        "orderId": {
          "type": "string",
          "format": "uuid",
          "description": "Payment order (payment sở hữu)"
        },
        "tenantId": {
          "type": "string",
          "format": "uuid",
          "description": "Người thuê (identity)"
        },
        "ownerId": {
          "type": "string",
          "format": "uuid",
          "description": "Chủ trọ (identity)"
        },
        "amountVnd": {
          "type": "integer",
          "minimum": 1,
          "description": "Số tiền đã nhận (VND)"
        },
        "payosReference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Mã giao dịch payOS, duy nhất"
        },
        "paidAt": {
          "type": "string",
          "format": "date-time",
          "description": "Thời điểm thanh toán theo payOS"
        }
      }
    }
  }
}
