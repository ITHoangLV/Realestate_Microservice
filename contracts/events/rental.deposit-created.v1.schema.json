{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realestate.local/contracts/events/rental.deposit-created.v1.schema.json",
  "title": "rental.deposit-created",
  "description": "DepositCreated: đơn PENDING_PAYMENT, BĐS đang giữ chỗ",
  "x-producer": "rental",
  "allOf": [
    {
      "$ref": "envelope.v1.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "rental.deposit-created"
    },
    "version": {
      "const": 1
    },
    "producer": {
      "const": "rental"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["depositId", "listingId", "tenantId", "ownerId", "amountVnd", "expiresAt"],
      "properties": {
        "depositId": {
          "type": "string",
          "format": "uuid",
          "description": "Đơn đặt cọc (rental sở hữu)"
        },
        "listingId": {
          "type": "string",
          "format": "uuid",
          "description": "Tin đăng (listing sở hữu)"
        },
        "tenantId": {
          "type": "string",
          "format": "uuid",
          "description": "Người thuê (identity)"
        },
        "ownerId": {
          "type": "string",
          "format": "uuid",
          "description": "Chủ trọ (identity)"
        },
        "amountVnd": {
          "type": "integer",
          "minimum": 1,
          "description": "Tiền cọc, bản chụp (VND)"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "description": "Hết hạn giữ chỗ và link payOS"
        }
      }
    }
  }
}
