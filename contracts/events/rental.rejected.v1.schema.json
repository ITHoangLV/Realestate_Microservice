{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realestate.local/contracts/events/rental.rejected.v1.schema.json",
  "title": "rental.rejected",
  "x-producer": "rental",
  "allOf": [{ "$ref": "envelope.v1.schema.json" }],
  "properties": {
    "eventType": { "const": "rental.rejected" },
    "version": { "const": 1 },
    "producer": { "const": "rental" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reservationId", "listingId", "tenantId", "landlordId", "reason"],
      "properties": {
        "reservationId": {
          "type": "string",
          "format": "uuid",
          "description": "Reservation (rental sở hữu)"
        },
        "listingId": {
          "type": "string",
          "format": "uuid",
          "description": "Tin đăng (listing sở hữu)"
        },
        "tenantId": { "type": "string", "format": "uuid", "description": "Người thuê (identity)" },
        "landlordId": { "type": "string", "format": "uuid", "description": "Chủ nhà (identity)" },
        "reason": {
          "type": ["string", "null"],
          "maxLength": 500,
          "description": "Lý do chủ nhà ghi (có thể null)"
        }
      }
    }
  }
}
