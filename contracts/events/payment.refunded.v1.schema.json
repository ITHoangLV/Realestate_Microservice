{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realestate.local/contracts/events/payment.refunded.v1.schema.json",
  "title": "payment.refunded",
  "description": "DepositRefunded: quản trị viên hoàn tất yêu cầu hoàn (có chứng từ)",
  "x-producer": "payment",
  "allOf": [
    {
      "$ref": "envelope.v1.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "payment.refunded"
    },
    "version": {
      "const": 1
    },
    "producer": {
      "const": "payment"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "depositId",
        "refundRequestId",
        "tenantId",
        "ownerId",
        "amountVnd",
        "requesterType"
      ],
      "properties": {
        "depositId": {
          "type": "string",
          "format": "uuid",
          "description": "Đơn đặt cọc (rental sở hữu)"
        },
        "refundRequestId": {
          "type": "string",
          "format": "uuid",
          "description": "Yêu cầu hoàn (payment sở hữu)"
        },
        "tenantId": {
          "type": "string",
          "format": "uuid",
          "description": "Người thuê (identity)"
        },
        "ownerId": {
          "type": "string",
          "format": "uuid",
          "description": "Chủ trọ (identity)"
        },
        "amountVnd": {
          "type": "integer",
          "minimum": 1,
          "description": "Số tiền đã hoàn (VND)"
        },
        "requesterType": {
          "enum": ["TENANT", "SYSTEM"],
          "description": "TENANT: người thuê tự hủy (70%); SYSTEM: tiền đến muộn (100%, đơn EXPIRED)"
        }
      }
    }
  }
}
